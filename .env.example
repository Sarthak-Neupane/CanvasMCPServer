# Canvas MCP Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file.

# Your Canvas API access token (generate one at <your-canvas-url>/profile
# under "Approved Integrations").
CANVAS_API_TOKEN=your_api_token_here

# Base API URL of your Canvas instance. Must end at /api (NOT /api/v1) --
# the server posts GraphQL queries to {CANVAS_BASE_URL}/graphql.
#
# Replace "your-school" with your institution's Canvas subdomain. It is the
# domain you see in the address bar when you log in to Canvas, e.g.
# https://<your-school>.instructure.com (some schools use a custom domain
# like https://canvas.<your-school>.edu -- use whatever you log in with,
# with /api appended).
#
# Note: the public canvas.instructure.com (Free-for-Teacher) instance was
# permanently discontinued in 2026, so a school/institution domain is required.
CANVAS_BASE_URL=https://your-school.instructure.com/api

# Request timeout in seconds
CANVAS_TIMEOUT=30

# Local directory for downloaded Canvas files (expanded ~ paths supported).
# Downloads are written under {CANVAS_DOWNLOAD_DIR}/{course_name}/{folder?}/{filename}
CANVAS_DOWNLOAD_DIR=~/Downloads/Canvas

# Timeout in seconds for binary file downloads (defaults to CANVAS_TIMEOUT)
# CANVAS_DOWNLOAD_TIMEOUT=60

# Maximum single-file download size in megabytes (default 100).
# CANVAS_MAX_DOWNLOAD_SIZE_MB=100

# HTTP retry policy for transient Canvas failures (429, 5xx, network).
# CANVAS_MAX_RETRIES=3
# CANVAS_RETRY_BASE_DELAY=1.0

# Optional: Debug settings
DEBUG=false
LOG_LEVEL=INFO
